rules_version = '2';

/**
 * Firestore Security Rules for SpendSmart
 *
 * Data Structure:
 * /users/{userId}
 *   ├── (user document with profile data)
 *   ├── /transactions/{transactionId}
 *   ├── /accounts/{accountId}
 *   ├── /budgets/{budgetId}
 *   └── /categories/{categoryId}
 */
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper function to validate required string field
    function hasRequiredString(field) {
      return field is string && field.size() > 0;
    }

    // Helper function to validate amount (positive number)
    function isValidAmount(amount) {
      return amount is number && amount >= 0;
    }

    // Helper function to validate transaction type
    function isValidTransactionType(type) {
      return type in ['income', 'expense', 'transfer'];
    }

    // Helper function to validate account type
    function isValidAccountType(type) {
      return type in ['checking', 'savings', 'cash', 'credit_card', 'investment', 'mobile_money', 'other'];
    }

    // Helper function to validate budget frequency
    function isValidBudgetFrequency(frequency) {
      return frequency in ['weekly', 'monthly', 'yearly', 'custom'];
    }

    // ==========================================
    // USER DOCUMENT RULES
    // ==========================================
    match /users/{userId} {
      // Users can only read/write their own document
      allow read: if isOwner(userId);

      // Allow create only if authenticated and creating own document
      allow create: if isOwner(userId) &&
        hasRequiredString(request.resource.data.email);

      // Allow update only own document
      allow update: if isOwner(userId);

      // Prevent deletion of user document (should be handled by admin/backend)
      allow delete: if false;

      // ==========================================
      // TRANSACTIONS SUBCOLLECTION
      // ==========================================
      match /transactions/{transactionId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId) &&
          request.resource.data.uid == userId &&
          isValidTransactionType(request.resource.data.type) &&
          request.resource.data.amount is number &&
          hasRequiredString(request.resource.data.accountId);

        allow update: if isOwner(userId) &&
          request.resource.data.uid == userId;

        allow delete: if isOwner(userId);
      }

      // ==========================================
      // ACCOUNTS SUBCOLLECTION
      // ==========================================
      match /accounts/{accountId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId) &&
          request.resource.data.uid == userId &&
          hasRequiredString(request.resource.data.name) &&
          isValidAccountType(request.resource.data.type);

        allow update: if isOwner(userId) &&
          request.resource.data.uid == userId;

        allow delete: if isOwner(userId);
      }

      // ==========================================
      // BUDGETS SUBCOLLECTION
      // ==========================================
      match /budgets/{budgetId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId) &&
          request.resource.data.uid == userId &&
          hasRequiredString(request.resource.data.name) &&
          isValidAmount(request.resource.data.amount) &&
          isValidBudgetFrequency(request.resource.data.frequency);

        allow update: if isOwner(userId) &&
          request.resource.data.uid == userId;

        allow delete: if isOwner(userId);
      }

      // ==========================================
      // CATEGORIES SUBCOLLECTION (custom user categories)
      // ==========================================
      match /categories/{categoryId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId) &&
          hasRequiredString(request.resource.data.name) &&
          request.resource.data.type in ['income', 'expense'];

        allow update: if isOwner(userId);

        allow delete: if isOwner(userId);
      }
    }

    // ==========================================
    // DENY ALL OTHER ACCESS
    // ==========================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
